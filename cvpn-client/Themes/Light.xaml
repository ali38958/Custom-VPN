<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgPrimary" Color="#EFF6FF"/> <!-- Pale Blue -->
    <SolidColorBrush x:Key="BgSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgTertiary" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BgHover" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BorderPrimary" Color="#93C5FD"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="#BFDBFE"/>
