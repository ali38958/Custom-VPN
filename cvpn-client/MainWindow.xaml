<Window x:Class="CustomVPN.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom VPN — Secure Mesh Client" Height="620" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#090D16" Foreground="#F8FAFC" FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BackgroundBorder" Width="34" Height="18" CornerRadius="9" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#64748B" HorizontalAlignment="Left" Margin="1,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#06B6D4"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#0891B2"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="16"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Gradient Glows -->
        <Border Background="#090D16">
            <Canvas>
                <Ellipse Width="350" Height="350" Canvas.Left="-50" Canvas.Top="-50">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1506B6D4" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="350" Height="350" Canvas.Right="-50" Canvas.Bottom="-50">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1510B981" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
        </Border>

        <!-- Top Header Bar -->
        <Grid VerticalAlignment="Top" Height="60" Margin="24,10,24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#0E7490">
                    <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Custom VPN" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtServerEndpoint" Text="Target: https://PrivateNet" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnChangeServer" Content="Change Server" Padding="12,6" Background="#1E293B" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Click="BtnChangeServer_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- LOGIN VIEW -->
        <Border x:Name="PanelLogin" Margin="0,70,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="32">
            <StackPanel>
                <TextBlock Text="Client Device Authentication" FontWeight="Bold" FontSize="18" Foreground="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Locked 1:1 hardware session bound to this PC" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" Padding="10,8" Background="#020617" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16"/>

                <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Padding="10,8" Background="#020617" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20"/>

                <TextBlock x:Name="TxtLoginError" Text="" Foreground="#F87171" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button x:Name="BtnLogin" Content="Establish VPN Session" Padding="0,12" Background="#06B6D4" Foreground="#020617" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnResetDeviceLock" Content="Lost Device? Reset Lock" Margin="0,14,0,0" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnResetDeviceLock_Click"/>
            </StackPanel>
        </Border>

        <!-- DASHBOARD VIEW -->
        <Grid x:Name="PanelDashboard" Margin="24,70,24,20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Controls Column -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="20" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="VPN Status" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                        <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" Background="#10B981" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="CONNECTED" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Virtual Assigned IP" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtAssignedIp" Text="10.77.0.2" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,20"/>

                    <Border Background="#020617" CornerRadius="12" Padding="14" Margin="0,0,0,20" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Route All Internet Traffic" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0"/>
                            <TextBlock Text="Enforces full tunnel encryption" FontSize="10" Foreground="#64748B" Margin="0,2,0,10"/>
                            <CheckBox x:Name="ChkRouteAll" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Content="Redirect Default Gateway" Checked="ChkRouteAll_Checked" Unchecked="ChkRouteAll_Unchecked"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnSendFile" Content="📁 Send File to Peer" Padding="0,10" Background="#1E293B" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Margin="0,0,0,12" Click="BtnSendFile_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnLogout" Content="Release Device &amp; Sign Out" Padding="0,10" Background="#450A0A" Foreground="#FCA5A5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnLogout_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Peers Column -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Network Peers &amp; Devices" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                        <TextBlock Text="Direct P2P file transfers accessible over OpenVPN addresses" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="ListPeers" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#020617" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="💻" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                            <TextBlock Text="{Binding DeviceName}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ip}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                            <Border Background="#065F46" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
