<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Custom VPN" Manufacturer="Resolvia" Version="0.2.0.0" UpgradeCode="12345678-1234-1234-1234-123456789012">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Custom VPN is already installed." />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Custom VPN" />
    </StandardDirectory>
    
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Custom VPN"/>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component>
        <File Id="CustomVPN.exe" Source="..\cvpn-client\bin\Release\net10.0-windows\win-x64\publish\CustomVPN.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="87654321-4321-4321-4321-210987654321">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="CVPN-Client"
                  Description="Secure Mesh VPN Client"
                  Target="[#CustomVPN.exe]"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\CustomVPN" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
